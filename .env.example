# ───── REQUIRED ─────
# Bot token from @BotFather
TELEGRAM_BOT_TOKEN=
# Model API key from openrouter.ai
OPENROUTER_API_KEY=

# ───── OPTIONAL ─────
# Model name. Function calling support is mandatory.
OPENROUTER_MODEL=deepseek/deepseek-chat
# Any OpenAI-compatible endpoint (OpenRouter, Google AI Studio, Groq, Together, ...)
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_TIMEOUT=60
MAX_TOOL_ITERATIONS=6

# Where user profiles are stored.
# On Render attach a Disk and set /var/data/users.json, otherwise profiles are wiped on every deploy.
USERS_FILE=data/users.json

# Comma-separated Telegram IDs. Empty = the bot is open to everyone.
ALLOWED_USER_IDS=

# Defaults for new users
DEFAULT_CURRENCY=KZT
TIMEZONE=Asia/Almaty

# Health-check port (Render injects it automatically)
PORT=8080
