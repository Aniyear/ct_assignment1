# ───── ОБЯЗАТЕЛЬНО ─────
# Токен бота от @BotFather
TELEGRAM_BOT_TOKEN=
# Ключ модели с openrouter.ai
OPENROUTER_API_KEY=

# ───── НЕОБЯЗАТЕЛЬНО ─────
# Модель. Нужна поддержка function calling.
OPENROUTER_MODEL=deepseek/deepseek-chat
# Адрес API, совместимого с OpenAI (можно подставить Groq, Together и т.д.)
LLM_BASE_URL=https://openrouter.ai/api/v1

# Где хранить профили пользователей.
# На Render подключи Disk и поставь /var/data/users.json, иначе профили струтся при деплое.
USERS_FILE=data/users.json

# Белый список Telegram ID через запятую. Пусто = бот открыт для всех.
ALLOWED_USER_IDS=

# Валюта и часовой пояс по умолчанию для новых пользователей
DEFAULT_CURRENCY=₸
TIMEZONE=Asia/Almaty

# Порт для health-check (Render подставляет сам)
PORT=8080
