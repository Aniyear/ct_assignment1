# ───── REQUIRED ─────
# Bot token from @BotFather
TELEGRAM_BOT_TOKEN=

# ───── MODEL PROVIDER ─────
# Which provider to use: openrouter | gemini | groq | custom
# Fill in only the key of the provider you picked, the rest can stay empty.
AI_PROVIDER=openrouter

# 1) OpenRouter — openrouter.ai/keys
#    default model: deepseek/deepseek-chat
OPENROUTER_API_KEY=

# 2) Google Gemini — aistudio.google.com/apikey
#    default model: gemini-2.0-flash (free tier available)
GEMINI_API_KEY=

# 3) Groq — console.groq.com/keys
#    default model: llama-3.3-70b-versatile
GROQ_API_KEY=

# Optional overrides. Leave empty to use the provider preset.
# The model MUST support function calling, otherwise the agent cannot write to Notion.
LLM_MODEL=
LLM_BASE_URL=
# Used only when AI_PROVIDER=custom
LLM_API_KEY=

LLM_TIMEOUT=60
MAX_TOOL_ITERATIONS=6

# ───── OPTIONAL ─────
# Where user profiles are stored.
# On Render attach a Disk and set /var/data/users.json, otherwise profiles are wiped on every deploy.
USERS_FILE=data/users.json

# Comma-separated Telegram IDs. Empty = the bot is open to everyone.
ALLOWED_USER_IDS=

# Defaults for new users
DEFAULT_CURRENCY=KZT
TIMEZONE=Asia/Almaty

# Health-check port (Render injects it automatically)
PORT=8080
